# Modified for the English text/TXT demo; scope and behavior are documented in README.md.
# Provider: auto, minimax, or openai (also for DeepSeek).
LLM_PROVIDER=auto
# Required for non-OpenAI compatible endpoints; blank uses provider default.
LLM_MODEL=

# MiniMax API Configuration
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_BASE=https://api.minimax.chat/v1

# OpenAI-compatible fallback (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# Application Settings
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# DeepSeek: set LLM_PROVIDER=openai, OPENAI_API_KEY to your DeepSeek key,
# OPENAI_API_BASE=https://api.deepseek.com and LLM_MODEL=deepseek-flash.
# Restart the server after changing .env. Use # for comments, not semicolons.
